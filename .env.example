# Copy to .env and adjust. Every value is optional.

# --- LLM (any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=<<api_key>>  # e.g. OpenAI, Azure OpenAI, OpenRouter, Ollama, Groq
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# LLM_BASE_URL=http://localhost:11434/v1     # e.g. Ollama, Groq, OpenRouter
# VALIDATOR_MODE=auto                        # auto | llm | heuristic

# --- models ---
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5     # re-run scripts/ingest.py after changing
# EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:
# CAPTION_MODEL=Salesforce/blip-image-captioning-base
# DEVICE=auto                                # auto | cpu | cuda

# --- paths ---
# PDF_DIR=data/pdfs
# IMAGE_DIR=data/images
# VECTORSTORE_DIR=data/vectorstore

# --- retrieval ---
# TEXT_WEIGHT=0.6
# IMAGE_WEIGHT=0.4
# TOP_K_TEXT=20
# TOP_K_IMAGE=8
# MAX_CONTEXT_RECIPES=4
# MIN_RECIPE_SCORE=0.60
